# PostgreSQL
POSTGRES_DB=expense_tracker_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Spring
SPRING_PROFILES_ACTIVE=prod

# JWT
JWT_SECRET_KEY=replace_with_a_long_secret_key
JWT_EXPIRATION=3600000

# Optional admin seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Docker / frontend
APP_PORT=8081

# Local Docker:
ALLOWED_ORIGINS=http://localhost:8081

# On the home server, you can add the Tailscale address, for example:
# ALLOWED_ORIGINS=http://localhost:8081,http://100.x.x.x:8081